# Contact form email, sent through Gmail SMTP.
# SMTP_PASSWORD must be a Google App Password, not the normal account password:
# turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Sender shown on the email, e.g. "CNSS Website <you@gmail.com>". Gmail only allows SMTP_USER
# or one of its verified "Send mail as" aliases. Leave empty to send as
# "nuclearsafety.ca Contact Form" <SMTP_USER>.
MAIL_FROM=
# Where enquiries are delivered. Separate multiple addresses with commas.
MAIL_TO=
